<Application x:Class="Silfy.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackground" Color="#10131C" />
    <SolidColorBrush x:Key="PanelBackground" Color="#1B2030" />
    <SolidColorBrush x:Key="AccentBrush" Color="#A78BFA" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F5F3FF" />
      <Setter Property="Background" Value="#34304B" />
      <Setter Property="BorderBrush" Value="#5B4B83" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Application.Resources>
</Application>
