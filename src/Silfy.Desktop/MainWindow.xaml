<Window x:Class="Silfy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Silfy" Height="650" Width="980" MinHeight="560" MinWidth="820"
        Background="{StaticResource WindowBackground}" Foreground="#F4F2FA"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Silfy" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="Локальный интеллектуальный помощник" Foreground="#A6A2B5" Margin="0,3,0,0" />
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#26233A" CornerRadius="14" Padding="14,8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="22" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Главная" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Состояние голосовой подсистемы" Foreground="#A6A2B5" Margin="0,6,0,18" />
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Голосовой движок" Foreground="#C9C5D6"/><TextBlock Grid.Column="1" Text="{Binding EngineText}" />
          </Grid>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Микрофон" Foreground="#C9C5D6"/><TextBlock Grid.Column="1" Text="{Binding MicrophoneText}" />
          </Grid>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Подписка" Foreground="#C9C5D6"/><TextBlock Grid.Column="1" Text="Free" />
          </Grid>
          <Separator Margin="0,15,0,15" Background="#353247" />
          <TextBlock Text="Последняя распознанная фраза" Foreground="#A6A2B5" />
          <TextBlock Text="{Binding LastRecognizedText}" FontSize="17" TextWrapping="Wrap" Margin="0,8,0,18" />
          <TextBlock Text="Состояние операции" Foreground="#A6A2B5" />
          <TextBlock Text="{Binding OperationText}" TextWrapping="Wrap" Margin="0,8,0,18" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Начать слушать" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
            <Button Content="Остановить" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" />
          </StackPanel>
          <TextBlock Text="{Binding ErrorText}" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="4,12,4,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="22" Margin="12,0,0,0">
        <StackPanel>
          <TextBlock Text="Разделы" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
          <TextBlock Text="Команды" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="Зарегистрированные обработчики: время, открыть YouTube." Foreground="#A6A2B5" TextWrapping="Wrap" Margin="0,5,0,18" />
          <TextBlock Text="Голос" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="Keyword Spotting, ASR и TTS используют локальные модели, заданные в config/voice.json." Foreground="#A6A2B5" TextWrapping="Wrap" Margin="0,5,0,18" />
          <TextBlock Text="Интеграции" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="Steam и Spotify будут подключены отдельными модулями. Голосовое управление Spotify исключено из-за правил Spotify Developer Policy." Foreground="#A6A2B5" TextWrapping="Wrap" Margin="0,5,0,18" />
          <TextBlock Text="Диагностика" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="Python stderr: Trace output. Локальные модели не загружаются автоматически." Foreground="#A6A2B5" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
      </Border>
    </Grid>
    <DockPanel Grid.Row="2" Margin="2,16,2,0">
      <TextBlock Text="Silfy foundation v0.1" Foreground="#777386" />
      <TextBlock DockPanel.Dock="Right" Text="Закрытие окна сворачивает приложение в трей" Foreground="#777386" />
    </DockPanel>
  </Grid>
</Window>
